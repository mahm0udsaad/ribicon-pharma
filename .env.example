# Copy to .env.local for development. In production set these in cPanel > Setup Node.js App > Environment variables.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE
# 64 random hex chars: openssl rand -hex 32
SESSION_SECRET=
# npm run admin:hash-password -- "a long password"
ADMIN_PASSWORD_HASH=
# Where admin-uploaded images are stored (outside the app folder in production so deploys don't wipe them)
UPLOAD_DIR=./uploads
